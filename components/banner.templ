package components

import "modulacms.com/content"

templ BannerComponent(b content.Banner) {
	<div class="relative isolate flex items-center gap-x-6 overflow-hidden bg-surface-1/50 px-6 py-2.5 sm:px-3.5 sm:before:flex-1">
		<div class="flex flex-wrap items-center gap-x-4 gap-y-2">
			<p class="text-sm/6 text-fg">
				{ b.Text }
			</p>
			if b.CTAText != "" && b.URL != "" {
				<a href={ templ.SafeURL(b.URL) } class="flex-none rounded-full bg-white/10 px-3.5 py-1 text-sm font-semibold text-fg shadow-xs no-underline inset-ring inset-ring-white/20 hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg">
					{ b.CTAText } <span aria-hidden="true">&rarr;</span>
				</a>
			}
		</div>
		<div class="flex flex-1 justify-end">
			if b.Dismissable {
				<button type="button" class="-m-3 p-3 focus-visible:-outline-offset-4" onclick="this.closest('div.relative').remove()">
					<span class="sr-only">Dismiss</span>
					<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5 text-fg">
						<path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"></path>
					</svg>
				</button>
			}
		</div>
	</div>
}
