package components

import "modulacms.com/content"

templ CardBlock(card content.Card) {
	<div class="flex flex-col rounded-2xl bg-surface-1 p-8 ring-1 ring-inset ring-edge transition duration-150 hover:ring-edge-accent">
		<h3 class="text-base/7 font-semibold text-fg">{ card.Title }</h3>
		<p class="mt-4 flex flex-auto flex-col text-base/7 text-fg-muted">{ card.Description }</p>
	</div>
}
