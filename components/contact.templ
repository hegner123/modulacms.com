package components

import "modulacms.com/content"

templ ContactSectionComponent(c content.ContactSection) {
	<div class="bg-surface-0 py-24 sm:py-32">
		<div class="mx-auto max-w-7xl px-6 lg:px-8">
			<div class="mx-auto max-w-2xl lg:mx-0">
				if c.Heading != "" {
					<h2 class="text-4xl font-semibold tracking-tight text-pretty text-fg sm:text-5xl">{ c.Heading }</h2>
				}
				if c.Description != "" {
					<p class="mt-6 text-lg/8 text-fg-faint">{ c.Description }</p>
				}
			</div>
			<div class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-8 text-base/7 sm:grid-cols-2 sm:gap-y-16 lg:mx-0 lg:max-w-none lg:grid-cols-4">
				for _, child := range c.Resolved {
					if child.ContactDetail != nil {
						@ContactDetailComponent(*child.ContactDetail)
					}
				}
			</div>
		</div>
	</div>
}

templ ContactDetailComponent(d content.ContactDetail) {
	<div>
		<h3 class="border-l border-accent pl-6 font-semibold text-fg">{ d.Label }</h3>
		<address class="border-l border-white/10 pt-2 pl-6 text-fg-faint not-italic">
			<p>{ d.Value }</p>
		</address>
	</div>
}
