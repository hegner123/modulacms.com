package components

import "modulacms.com/content"

templ CTABlock(cta content.CTA) {
	<div class="px-6 py-24 sm:py-32 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{ cta.Heading }</h2>
			<p class="mx-auto mt-6 max-w-xl text-lg/8 text-pretty text-fg-muted">{ cta.Subheading }</p>
			if cta.ButtonText != "" {
				<div class="mt-10 flex items-center justify-center gap-x-6">
					<a class="btn btn-primary" href={ templ.SafeURL(cta.ButtonURL) }>{ cta.ButtonText }</a>
				</div>
			}
		</div>
	</div>
}
