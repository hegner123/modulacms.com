package components

import "modulacms.com/content"

templ CTASectionComponent(cta content.CTASection) {
	<section class="py-24 sm:py-32">
		<div class="mx-auto max-w-3xl">
			<h2 class="mt-2 text-4xl font-semibold tracking-tight text-pretty sm:text-5xl">{ cta.Heading }</h2>
			if cta.Description != "" {
				<p class="mt-6 text-lg/8 text-pretty text-fg-muted">{ cta.Description }</p>
			}
			if cta.CTAText != "" {
				<div class="mt-10">
					<a class="btn btn-primary" href={ templ.SafeURL(cta.CTAURL) }>{ cta.CTAText }</a>
				</div>
			}
		</div>
	</section>
}
