package components

import "modulacms.com/content"

templ FAQSectionComponent(f content.FAQSection) {
	<div class="bg-surface-0">
		<div class="mx-auto max-w-7xl px-6 py-16 sm:py-24 lg:px-8">
			if f.Heading != "" {
				<h2 class="text-4xl font-semibold tracking-tight text-fg sm:text-5xl">{ f.Heading }</h2>
			}
			if f.Eyebrow != "" {
				<p class="mt-6 max-w-2xl text-base/7 text-fg-faint">{ f.Eyebrow }</p>
			}
			<div class="mt-20">
				<dl class="space-y-16 sm:grid sm:grid-cols-2 sm:space-y-0 sm:gap-x-6 sm:gap-y-16 lg:gap-x-10">
					for _, child := range f.Resolved {
						if child.FAQItem != nil {
							@FAQItemComponent(*child.FAQItem)
						}
					}
				</dl>
			</div>
		</div>
	</div>
}

templ FAQItemComponent(item content.FAQItem) {
	<div>
		<dt class="text-base/7 font-semibold text-fg">{ item.Question }</dt>
		<dd class="mt-2 text-base/7 text-fg-faint">
			@templ.Raw(item.Answer)
		</dd>
	</div>
}
