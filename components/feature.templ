package components

import "modulacms.com/content"

templ FeatureSectionComponent(f content.FeatureSection) {
	<div class="bg-surface-0 py-24 sm:py-32">
		<div class="mx-auto max-w-7xl px-6 lg:px-8">
			<div class="mx-auto max-w-2xl lg:mx-0">
				if f.Eyebrow != "" {
					<h2 class="text-base/7 font-semibold text-accent">{ f.Eyebrow }</h2>
				}
				if f.Heading != "" {
					<p class="mt-2 text-4xl font-semibold tracking-tight text-pretty text-fg sm:text-5xl">{ f.Heading }</p>
				}
				if f.Description != "" {
					<p class="mt-6 text-lg/8 text-fg-muted">{ f.Description }</p>
				}
			</div>
			if f.ImageDkURL != "" || f.ImageURL != "" {
				<div class="mt-16 sm:mt-24">
					if f.ImageDkURL != "" {
						<img src={ f.ImageDkURL } alt="" class="mx-auto rounded-xl shadow-2xl ring-1 ring-edge"/>
					} else if f.ImageURL != "" {
						<img src={ f.ImageURL } alt="" class="mx-auto rounded-xl shadow-2xl ring-1 ring-edge"/>
					}
				</div>
			}
			<dl class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-8 text-base/7 text-fg-muted sm:grid-cols-2 lg:mx-0 lg:max-w-none lg:grid-cols-3 lg:gap-x-16">
				for _, child := range f.Resolved {
					if child.FeatureItem != nil {
						@FeatureItemComponent(*child.FeatureItem)
					}
				}
			</dl>
		</div>
	</div>
}

templ FeatureItemComponent(item content.FeatureItem) {
	<div class="relative pl-9">
		<dt class="inline font-semibold text-fg">
			if item.Icon != "" {
				<span class="absolute top-1 left-1 text-accent">{ item.Icon }</span>
			} else {
				<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="absolute top-1 left-1 size-5 text-accent">
					<path d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" fill-rule="evenodd"></path>
				</svg>
			}
			{ item.Title }
		</dt>
		if item.Description != "" {
			<dd class="inline"> { item.Description }</dd>
		}
	</div>
}
