package components

templ PlaygroundPage() {
	@Layout("Content Model Playground — ModulaCMS", "Interactive content modeling playground. Define datatypes and fields, preview schema tables and API responses — experience ModulaCMS before installing.") {
		<link rel="stylesheet" href="/static/playground.css"/>
		<main class="pg-main">
			<header class="pg-header">
				<div class="pg-header-inner">
					<a href="/" class="pg-back-link">ModulaCMS</a>
					<h1>Content Model Playground</h1>
					<p class="pg-subtitle">Define datatypes and fields, see the schema and API response update live.</p>
				</div>
			</header>
			<cms-playground></cms-playground>
		</main>
		<script src="/static/playground.js"></script>
	}
}
