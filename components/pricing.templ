package components

import "modulacms.com/content"

templ PricingSectionComponent(p content.PricingSection) {
	<div class="bg-surface-0 py-24 sm:py-32">
		<div class="mx-auto max-w-7xl px-6 lg:px-8">
			<div class="mx-auto max-w-4xl text-center">
				if p.Eyebrow != "" {
					<h2 class="text-base/7 font-semibold text-accent">{ p.Eyebrow }</h2>
				}
				if p.Heading != "" {
					<p class="mt-2 text-5xl font-semibold tracking-tight text-balance text-fg sm:text-6xl">{ p.Heading }</p>
				}
			</div>
			if p.Description != "" {
				<p class="mx-auto mt-6 max-w-2xl text-center text-lg font-medium text-pretty text-fg-muted sm:text-xl/8">{ p.Description }</p>
			}
			<div class="isolate mx-auto mt-16 grid max-w-md grid-cols-1 gap-y-8 sm:mt-20 lg:mx-0 lg:max-w-none lg:grid-cols-3">
				for _, child := range p.Resolved {
					if child.PricingTier != nil {
						@PricingTierComponent(*child.PricingTier)
					}
				}
			</div>
		</div>
	</div>
}

templ PricingTierComponent(tier content.PricingTier) {
	<div
		if tier.Highlighted {
			class="flex flex-col justify-between rounded-3xl bg-surface-1/50 p-8 inset-ring inset-ring-edge lg:z-10 lg:rounded-b-none xl:p-10"
		} else {
			class="flex flex-col justify-between rounded-3xl bg-surface-1/50 p-8 inset-ring inset-ring-edge lg:mt-8 xl:p-10"
		}
	>
		<div>
			<div class="flex items-center justify-between gap-x-4">
				if tier.Highlighted {
					<h3 class="text-lg/8 font-semibold text-accent">{ tier.Name }</h3>
					<p class="rounded-full bg-accent/10 px-2.5 py-1 text-xs/5 font-semibold text-accent">Most popular</p>
				} else {
					<h3 class="text-lg/8 font-semibold text-fg">{ tier.Name }</h3>
				}
			</div>
			if tier.Description != "" {
				<p class="mt-4 text-sm/6 text-fg-muted">{ tier.Description }</p>
			}
			<p class="mt-6 flex items-baseline gap-x-1">
				<span class="text-4xl font-semibold tracking-tight text-fg">{ tier.Price }</span>
			</p>
			<ul role="list" class="mt-8 space-y-3 text-sm/6 text-fg-muted">
				for _, child := range tier.Resolved {
					if child.PricingFeature != nil {
						@PricingFeatureComponent(*child.PricingFeature)
					}
				}
			</ul>
		</div>
		if tier.CTAText != "" {
			if tier.Highlighted {
				<a href={ templ.SafeURL(tier.CTAURL) } class="mt-8 block rounded-md bg-accent px-3 py-2 text-center text-sm/6 font-semibold text-white shadow-xs hover:bg-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">{ tier.CTAText }</a>
			} else {
				<a href={ templ.SafeURL(tier.CTAURL) } class="mt-8 block rounded-md bg-white/10 px-3 py-2 text-center text-sm/6 font-semibold text-fg inset-ring inset-ring-white/5 hover:bg-white/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">{ tier.CTAText }</a>
			}
		}
	</div>
}

templ PricingFeatureComponent(f content.PricingFeature) {
	<li class="flex gap-x-3">
		<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="h-6 w-5 flex-none text-accent">
			<path d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" fill-rule="evenodd"></path>
		</svg>
		{ f.Text }
	</li>
}
