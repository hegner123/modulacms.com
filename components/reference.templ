package components

import "modulacms.com/content"

templ ReferenceBlock(ref content.Reference) {
	<div class="mt-10 border-l border-accent pl-9">
		<a class="text-sm/6 font-semibold text-accent hover:text-accent-hover" href={ templ.SafeURL(ref.URL) }>{ ref.Label } <span aria-hidden="true">&#8594;</span></a>
		if ref.Description != "" {
			<p class="mt-2 text-base/7 text-fg-muted">{ ref.Description }</p>
		}
	</div>
}
