package components

import "modulacms.com/content"

templ RowComponent(row content.Row) {
	<section class="row">
		<div class="row-inner">
			for _, cols := range row.Columns {
				@ColumnsComponent(cols)
			}
			for _, child := range row.Resolved {
				@ChildNode(child)
			}
		</div>
	</section>
}
