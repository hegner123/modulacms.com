package components

import (
	"fmt"
	"modulacms.com/content"
)

templ StepHeaderBlock(sh content.StepHeader) {
	<div class="mb-8 flex items-start gap-x-4">
		<span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-accent font-mono text-sm font-bold text-surface-0">{ fmt.Sprintf("%d", sh.StepNumber) }</span>
		<div>
			<h3 id={ content.Slugify(sh.Title) } class="text-base/7 font-semibold text-fg scroll-mt-20">{ sh.Title }</h3>
			if sh.Description != "" {
				<p class="mt-1 text-base/7 text-fg-muted">{ sh.Description }</p>
			}
		</div>
	</div>
}
